# Copy to .env (never commit .env). Every setting is optional: with none, TeamMate runs offline with templates.

# --- TeamMate execution mode ---
# mock  : rule planner + role templates (default, no network)
# gemma : Gemma plans, templates execute (needs GEMMA_API_KEY)
# llm   : a model plans and builder roles write the code; QA and docs stay deterministic
AGENT_PROVIDER=mock

# --- Model providers (used by AGENT_PROVIDER=llm and IdeaMate council runs) ---
# Tried in this order; providers without a key are skipped. Add "ollama" for a local server.
LLM_PROVIDERS=gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
# Per-provider request limits, e.g. GROQ_RPM=30, GROQ_RPD=1000, OPENROUTER_RPD=50

# --- Gemma planner (AGENT_PROVIDER=gemma only; also used as the Gemini key if GEMINI_API_KEY is empty) ---
# GEMMA_API_KEY=
# GEMMA_MODEL=gemma-4-26b-a4b-it

# --- IdeaMate Deep research (optional) ---
# YOUTUBE_DATA_API_KEY=

# --- Server ---
# PORT=3001
# TEAMMATE_DB=server/data/teammate.db
# TEAMMATE_WORKSPACE=server/workspace
