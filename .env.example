# Copy to .env (optional — the app runs with no .env at all).

# mock = rule-based planner + role templates, no network (default)
# gemma = Gemma plans the tasks; the role templates still execute them
AGENT_PROVIDER=mock

# Google AI Studio key — only needed when AGENT_PROVIDER=gemma
GEMMA_API_KEY=your-google-ai-studio-key

# A Gemma model id your key can use (list them: GET https://generativelanguage.googleapis.com/v1beta/models)
# Verified 2026-10-18: gemma-4-26b-a4b-it (fast, default) and gemma-4-31b-it
GEMMA_MODEL=gemma-4-26b-a4b-it

# API port (the dev UI on :5173 proxies /api here)
PORT=3001

# Optional overrides. Defaults: server/data/teammate.db and server/workspace/
# Relative paths are resolved from the server/ folder.
# TEAMMATE_DB=data/teammate.db
# TEAMMATE_WORKSPACE=workspace
