# mock (default, no network) or gemma (Gemma plans, mock role templates execute)
AGENT_PROVIDER=mock
# Google AI Studio key — only needed for AGENT_PROVIDER=gemma
GEMMA_API_KEY=
# Pick an id that exists for your key: GET https://generativelanguage.googleapis.com/v1beta/models
GEMMA_MODEL=gemma-3-27b-it
PORT=3001
