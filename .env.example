# Copy to .env (optional — the app runs with no .env at all).

# mock = rule-based planner + role templates, no network (default)
# gemma = Gemma plans the tasks; the role templates still execute them
AGENT_PROVIDER=mock

# Google AI Studio key — only needed when AGENT_PROVIDER=gemma
GEMMA_API_KEY=your-google-ai-studio-key

# A Gemma model id your key can use (list them: GET https://generativelanguage.googleapis.com/v1beta/models)
# Verified 2026-10-18: gemma-4-26b-a4b-it (fast, default) and gemma-4-31b-it
GEMMA_MODEL=gemma-4-26b-a4b-it

# Optional official YouTube Data API research (GitHub Search API works without a key)
YOUTUBE_DATA_API_KEY=your-youtube-data-api-key

# --- LLM providers (optional; nothing below is used unless a key is set) ---
# Fallback order. Default: groq,gemini,openrouter. Add ollama to use a local Ollama server.
# LLM_PROVIDERS=groq,gemini,openrouter

# Groq (free plan): https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Google AI Studio (Gemini). Falls back to GEMMA_API_KEY when unset.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# OpenRouter free models (ids ending in :free): https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Local Ollama (no key)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# Request budgets per provider: <PROVIDER>_RPM / <PROVIDER>_RPD (positive integers).
# Defaults follow the published free tiers: Groq 30/1000, OpenRouter 20/50
# (set OPENROUTER_RPD=1000 after buying 10 credits). Gemini: none assumed (see AI Studio).
# GROQ_RPM=30
# GROQ_RPD=1000
# OPENROUTER_RPD=50

# API port (the dev UI on :5173 proxies /api here)
PORT=3001

# Optional overrides. Defaults: server/data/teammate.db and server/workspace/
# Relative paths are resolved from the server/ folder.
# TEAMMATE_DB=data/teammate.db
# TEAMMATE_WORKSPACE=workspace

# Playwright only: save E2E screenshots to this folder (npm run test:e2e)
# SCREENSHOTS_DIR=docs/screenshots
