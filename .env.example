# Copy to .env.local (never commit it). All keys stay on the server; the browser never sees them.

# Which model provider runs the stages: gemma (default), gemini, or mock (canned replies, no key needed).
LLM_PROVIDER=gemma
# Google AI Studio key (https://aistudio.google.com/apikey); used by both gemma and gemini.
GEMINI_API_KEY=
# Gemma model name for LLM_PROVIDER=gemma.
GEMMA_MODEL=gemma-4-26b-a4b-it
# Gemini model name for LLM_PROVIDER=gemini (also enables Google Search grounding for competitor research).
GEMINI_MODEL=gemini-2.5-flash
# Tavily key for live competitor search; without it Stage 2 uses a labelled "no live search" fallback.
TAVILY_API_KEY=
# Requests allowed per IP per 10 minutes on the stage routes.
RATE_LIMIT_PER_10_MIN=30
